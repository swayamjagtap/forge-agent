{
  "name": "forge-agent",
  "displayName": "Forge Agent",
  "description": "Minimal VS Code extension for Forge Agent",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forge-agent.hello",
        "title": "Forge Agent: Hello"
      },
      {
        "command": "forge-agent.undoLastAppliedChange",
        "title": "Forge Agent: Undo last applied change"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge-agent-chat",
          "title": "Forge Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forge-agent-chat": [
        {
          "type": "webview",
          "id": "forge-agent.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Forge Agent",
      "properties": {
        "forgeAgent.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of the TrueForge server"
        },
        "forgeAgent.agentName": {
          "type": "string",
          "default": "editor-test",
          "description": "Agent name to use for chat sessions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/diff": "^7.0.2",
    "diff": "^9.0.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
