{
  "name": "forge-agent",
  "displayName": "Forge Agent",
  "description": "VS Code client for TrueFoundry Forge: sidebar chat, MCP workspace tools, and hunk-by-hunk diff review with user approval before any file is written.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forge-agent.hello",
        "title": "Forge Agent: Hello"
      },
      {
        "command": "forge-agent.undoLastAppliedChange",
        "title": "Forge Agent: Undo last applied change"
      },
      {
        "command": "forgeAgent.editSelection",
        "title": "Forge Agent: Edit Selection"
      },
      {
        "command": "forgeAgent.switchModel",
        "title": "Forge Agent: Switch Model"
      },
      {
        "command": "forgeAgent.newChat",
        "title": "Forge Agent: New Chat"
      }
    ],
    "keybindings": [
      {
        "command": "forgeAgent.editSelection",
        "key": "ctrl+alt+k",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "forgeAgent.editSelection",
          "when": "editorHasSelection",
          "group": "modification"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge-agent-chat",
          "title": "Forge Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forge-agent-chat": [
        {
          "type": "webview",
          "id": "forge-agent.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Forge Agent",
      "properties": {
        "forgeAgent.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of the TrueForge server"
        },
        "forgeAgent.agentName": {
          "type": "string",
          "default": "editor-test",
          "description": "Agent name to use for chat sessions"
        },
        "forgeAgent.autoFallback": {
          "type": "boolean",
          "default": true,
          "description": "Automatically switch TrueForge agent to a fallback model when rate limited (429)"
        },
        "forgeAgent.fallbackModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "google-gemini/gemini-3-5-flash-lite",
            "google-gemini/gemini-3-1-flash-lite",
            "google-gemini/gemini-3-6-flash",
            "google-gemini/gemini-3-8-flash"
          ],
          "description": "List of TrueForge model names to attempt when automatic fallback triggers"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test out/editPipeline.test.js",
    "sync-agent": "node scripts/sync-agent.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/diff": "^7.0.2",
    "diff": "^9.0.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
